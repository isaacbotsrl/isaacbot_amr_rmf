# Lets the RMF site manager read an isaacbot's maps: installs its ssh key on that isaacbot's
# orchestrator container. Asks for the isaacbot's root password once.
#
#   docker compose -f docker/docker-compose.yml exec site-manager isaacbot-authorize [user@host [port]]
#   docker/rmf-server.sh exec site-manager isaacbot-authorize [user@host [port]]     (server)
#
# Each robot's page on the sites page shows the command for that robot. Without arguments:
# ISAACBOT_AMR_SSH / ISAACBOT_AMR_SSH_PORT (root@192.168.1.201, 24). The page has one key; each
# robot gets it once.
#
# The key stays in the site-manager-ssh volume. The isaacbot forgets it when its orchestrator
# container is recreated (a new release); run this again then. The new container also has new
# ssh host keys: this shows the new fingerprint and, once confirmed, forgets the old one.
set -e
TARGET="${1:-${ISAACBOT_AMR_SSH:-root@192.168.1.201}}"
PORT="${2:-${ISAACBOT_AMR_SSH_PORT:-24}}"
HOST="${TARGET#*@}"
KEY="$HOME/.ssh/id_ed25519"
[ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N '' -C isaacbot-rmf-site-manager -f "$KEY"
if ssh -p "$PORT" -o BatchMode=yes -o ConnectTimeout=10 "$TARGET" true 2>&1 \
        | grep -q 'REMOTE HOST IDENTIFICATION HAS CHANGED'; then
    echo "The isaacbot's ssh host key changed. A new isaacbot release does that. Its keys now:"
    ssh-keyscan -p "$PORT" "$HOST" 2>/dev/null | ssh-keygen -lf -
    read -r -p "Trust the new key? Only if the isaacbot was just updated or reflashed [y/N] " answer
    [ "$answer" = y ] || [ "$answer" = Y ] || { echo "Not changed."; exit 1; }
    ssh-keygen -q -R "[$HOST]:$PORT" >/dev/null
fi
echo "Installing the site manager's key on $TARGET (ssh port $PORT)."
ssh-copy-id -i "$KEY.pub" -p "$PORT" -o StrictHostKeyChecking=accept-new "$TARGET"
ssh -p "$PORT" -o BatchMode=yes "$TARGET" true && echo "Done: the RMF sites page can now read the isaacbot's maps."
